    {
        "id": "721f60d384036968",
        "type": "function",
        "z": "a28df3c664be5d89",
        "name": "sort objects or strings",
        "func": "msg.payload = msg.payload.sort( (a,b) => {\n    if (a.fn && b.fn) {\n        return a.fn < b.fn ? -1 : 1\n    } else {\n        return a < b ? -1 : 1\n    }\n})\nreturn msg;",
