{
    "_": {
        "editor": {
            "view": {
                "view-store-zoom": false,
                "view-store-position": false,
                "view-show-grid": false,
                "view-snap-grid": false,
                "view-grid-size": "20",
                "view-node-status": true,
                "view-node-show-label": true,
                "view-show-tips": false,
                "view-show-welcome-tours": true,
                "view-node-info-icon": true
            },
            "tours": {
                "welcome": "5.0.8"
            },
            "keymap": {
                "core:deploy-flows": {
                    "scope": "*",
                    "key": "ctrl-s"
                },
                "core:clear-debug-messages": {
                    "scope": "*",
                    "key": "ctrl-shift-d"
                },
                "core:show-event-log": {
                    "scope": "*",
                    "key": "ctrl-alt-l"
                },
                "core:zoom-reset": {
                    "scope": "red-ui-workspace",
                    "key": "ctrl-1"
                },
                "core:zoom-out": {
                    "scope": "red-ui-workspace",
                    "key": "ctrl-§"
                },
                "core:zoom-in": {
                    "scope": "red-ui-workspace",
                    "key": "ctrl-2"
                },
                "core:show-export-dialog": {
                    "scope": "red-ui-workspace",
                    "key": "ctrl-e"
                },
                "flowhub:flowhub-push-current-flow": {
                    "scope": "*",
                    "key": "ctrl-d"
                },
                "presenter-mode:delete-current-workspace": {
                    "scope": "*",
                    "key": "alt-w"
                },
                "core:hide-flow": {
                    "scope": "red-ui-workspace",
                    "key": "alt-l"
                },
                "presenter-mode:align-link-to-source": {
                    "scope": "red-ui-workspace",
                    "key": "alt-a s"
                },
                "presenter-mode:align-link-to-destination": {
                    "scope": "red-ui-workspace",
                    "key": "alt-a d"
                },
                "presenter-mode:presenter-mode-toggle": {
                    "scope": "*",
                    "key": "ctrl-p"
                },
                "presenter-mode:presenter-mode-reset": {
                    "scope": "*",
                    "key": "alt-p r"
                },
                "presenter-mode:presenter-mode-previous": {
                    "scope": "*",
                    "key": "alt-p p"
                },
                "presenter-mode:presenter-mode-next": {
                    "scope": "*",
                    "key": "alt-p n"
                }
            },
            "dialog": {
                "export": {
                    "pretty": true,
                    "json-view": true
                }
            },
            "sidebar": {
                "state": {
                    "v": 4,
                    "tabs": [],
                    "primary": {
                        "width": 300,
                        "top": {
                            "tabs": [
                                "info",
                                "help",
                                "config",
                                "context",
                                "Flow2Mermaid",
                                "IntrospectionMsgTrace",
                                "IntrospectionObfuscation",
                                "IntrospectionLint",
                                "IntrospectionCapture",
                                "ScratchPad",
                                "FlowCompare",
                                "sidebar-auto-layout",
                                "erlconfig"
                            ],
                            "height": 1150,
                            "hidden": false,
                            "active": "config"
                        },
                        "bottom": {
                            "tabs": [
                                "debug"
                            ],
                            "hidden": false,
                            "active": "debug"
                        }
                    },
                    "secondary": {
                        "width": 800,
                        "top": {
                            "tabs": [
                                "explorer",
                                "FlowHubDiff"
                            ],
                            "height": 570,
                            "hidden": false,
                            "active": "FlowHubDiff"
                        },
                        "bottom": {
                            "tabs": [
                                "palette",
                                "UnitTestingErlangRed"
                            ],
                            "hidden": false,
                            "active": "UnitTestingErlangRed"
                        }
                    }
                }
            }
        },
        "debug": {
            "filter": "filterAll",
            "filteredNodes": []
        },
        "menu-menu-item-sidebar": true,
        "menu-menu-item-left-sidebar": true,
        "menu-menu-item-right-sidebar": true
    }
}